#!/usr/bin/env python3
"""A stand-in for Claude Code's `claude -p` in `fastpilot run` tests.

It takes the same arguments, reads the prompt from stdin, starts the MCP server named in
--mcp-config (fastpilot's bridge) and plays a scripted agent over real MCP: start a web
session, log in with one run_flow, then call finish. Every invocation is logged as JSON in
$FAKE_CLAUDE_LOG (argv, prompt, tool names, tool results) for the test to inspect.

Env: FAKE_CLAUDE_FAIL=1 asserts a text that is not there; FAKE_CLAUDE_DELAY_MS waits before
each tool call; FAKE_CLAUDE_NOLOGIN=1 behaves like a logged-out Claude Code.
"""
import json, os, subprocess, sys, time

argv = sys.argv[1:]
if argv == ["--version"]:
    # FAKE_CLAUDE_VERSION: pretend to be another version (QA B1: an old Claude Code).
    print(os.environ.get("FAKE_CLAUDE_VERSION", "9.9.9") + " (Claude Code, fake)")
    sys.exit(0)

def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None

if argv[:1] == ["mcp"]:
    # `claude mcp add|get` for `fastpilot init`: logged; `add --scope project` writes .mcp.json in the
    # current folder like Claude Code, user scope goes to $HOME/.claude.json.
    log_dir = os.environ.get("FAKE_CLAUDE_LOG")
    if log_dir:
        os.makedirs(log_dir, exist_ok=True)
        with open(os.path.join(log_dir, f"{time.time_ns()}-mcp.json"), "w") as f:
            json.dump({"argv": argv, "cwd": os.getcwd()}, f)
    def store(scope):
        return os.path.join(os.getcwd(), ".mcp.json") if scope == "project" else os.path.join(os.environ["HOME"], ".claude.json")
    def load(path):
        try:
            with open(path) as f:
                return json.load(f)
        except FileNotFoundError:
            return {"mcpServers": {}}
    if argv[1] == "add":
        if os.environ.get("FAKE_CLAUDE_MCP_FAIL") == "1":
            print("add failed (stand-in)", file=sys.stderr)
            sys.exit(1)
        cut = argv.index("--")
        opts, cmd = argv[2:cut], argv[cut + 1:]
        scope = opts[opts.index("--scope") + 1] if "--scope" in opts else "local"
        name = [o for i, o in enumerate(opts) if not o.startswith("-") and (i == 0 or opts[i - 1] != "--scope")][0]
        path = store(scope)
        data = load(path)
        data.setdefault("mcpServers", {})[name] = {"type": "stdio", "command": cmd[0], "args": cmd[1:], "env": {}}
        with open(path, "w") as f:
            json.dump(data, f, indent=2)
        print(f"Added stdio MCP server {name} to {scope} config")
        sys.exit(0)
    if argv[1] == "get":
        name = argv[2]
        found = any(name in load(store(s)).get("mcpServers", {}) for s in ("project", "user"))
        print(f"{name}: found" if found else f"No MCP server found with name: {name}")
        sys.exit(0 if found else 1)
    sys.exit(2)

prompt = sys.stdin.read()
log_dir = os.environ.get("FAKE_CLAUDE_LOG")
entry = {"start": time.time(), "argv": argv, "prompt": prompt, "tools": [], "calls": []}
log_path = os.path.join(log_dir, f"{time.time_ns()}-{os.getpid()}.json") if log_dir else None

def save():
    if log_path:
        with open(log_path, "w") as f:
            json.dump(entry, f)

def result(text, is_error=False, turns=0, code=0):
    entry["end"] = time.time()
    save()
    print(json.dumps({"type": "result", "subtype": "error_during_execution" if is_error else "success",
                      "is_error": is_error, "num_turns": turns, "result": text,
                      "usage": {"input_tokens": 100, "output_tokens": 20, "cache_read_input_tokens": 50}}))
    sys.exit(code)

save()
if os.environ.get("FAKE_CLAUDE_NOLOGIN") == "1":
    result("Invalid API key · Please run /login", is_error=True, code=1)

server = json.loads(opt("--mcp-config"))["mcpServers"]["fastpilot"]
proc = subprocess.Popen([server["command"], *server["args"]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
next_id = 0

def rpc(method, params=None, notify=False):
    global next_id
    msg = {"jsonrpc": "2.0", "method": method}
    if params is not None:
        msg["params"] = params
    if not notify:
        next_id += 1
        msg["id"] = next_id
    proc.stdin.write(json.dumps(msg) + "\n")
    proc.stdin.flush()
    if notify:
        return None
    return json.loads(proc.stdout.readline())["result"]

def call(name, args):
    time.sleep(int(os.environ.get("FAKE_CLAUDE_DELAY_MS", "0")) / 1000)
    r = rpc("tools/call", {"name": name, "arguments": args})
    text = "\n".join(c.get("text", "") for c in r["content"] if c.get("type") == "text")
    entry["calls"].append({"name": name, "args": args, "ok": not r.get("isError"), "text": text})
    save()
    return r

rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-claude", "version": "0"}})
rpc("notifications/initialized", notify=True)
entry["tools"] = [t["name"] for t in rpc("tools/list")["tools"]]

plan = next((l for l in prompt.splitlines() if l.startswith("Session plan:")), "")

def side_by_side():
    """PF5: one platform of a side-by-side run of tests/login-side-by-side.md. Reports each numbered
    step with `step` and the text it found. Web runs real flows in Chrome; Android and iOS run real
    flows only with FAKE_CLAUDE_SIDE_REAL=1 (a device the test may use), else they report
    FAKE_CLAUDE_SIDE_FOUND_<PLATFORM> ("|"-separated found texts) without touching a device.
    FAKE_CLAUDE_SIDE_FAIL_<PLATFORM>=<n> fails step n there."""
    import re
    platform = next((l.split(":", 1)[1].strip() for l in prompt.splitlines() if l.startswith("platform:")), "web")
    target = next((l.split(":", 1)[1].strip() for l in prompt.splitlines() if l.startswith("target:")), "")
    n_steps = len([l for l in prompt.split("Side by side:", 1)[1].splitlines() if re.match(r"^\d+\. ", l)])
    key = platform.upper()
    fail_at = int(os.environ.get(f"FAKE_CLAUDE_SIDE_FAIL_{key}", "0"))
    real = platform == "web" or os.environ.get("FAKE_CLAUDE_SIDE_REAL") == "1"
    canned = os.environ.get(f"FAKE_CLAUDE_SIDE_FOUND_{key}", "Masuk ke Akun|Lupa password?|Masuk|Budi").split("|")
    flows = ["- assertVisible: \"Masuk ke Akun\"\n", None,
             "- inputText: { into: Email, text: a@b.com }\n- inputText: { into: Password, text: \"${DEMO_PASS}\" }\n- tapOn: Masuk\n",
             "- assertVisible: Budi\n"]
    if os.environ.get(f"FAKE_CLAUDE_SIDE_NOSTART_{key}") == "1":
        # QA re-test Low 3: the device session does not start (a device that is not there).
        device = "emulator-9999" if platform == "android" else "00000000-0000-4000-8000-000000000000"
        call("session", {"action": "start", "id": platform[:3] + "1", "platform": platform, "target": target, "device": device})
        call("finish", {"status": "fail", "notes": "could not start: " + entry["calls"][-1]["text"][:200]})
        return
    if real:
        r = call("session", {"action": "start", "id": platform[:3] + "1", "platform": platform, "target": target})
        if r.get("isError"):
            call("finish", {"status": "fail", "notes": "could not start: " + entry["calls"][-1]["text"][:200]})
            return
    passed = True
    for n in range(1, n_steps + 1):
        found, ok, notes = canned[n - 1] if n - 1 < len(canned) else "", True, ""
        if real and n - 1 < len(flows):
            if flows[n - 1] is None:
                # The link's own words, read from the screen.
                r = call("snapshot", {"filter": "Lupa"})
                m = re.search(r'"([^"]*Lupa[^"]*)"', entry["calls"][-1]["text"])
                ok, found = m is not None, (m.group(1) if m else "")
            else:
                r = call("run_flow", {"flow": flows[n - 1]})
                ok = not r.get("isError")
        if n == fail_at:
            ok, notes = False, "field not found"
        call("step", {"step": n, "status": "pass" if ok else "fail", "found": found if ok else "", "notes": notes})
        if not ok:
            passed = False
            break
    call("finish", {"status": "pass" if passed else "fail", "notes": "side by side on " + platform if passed else "field not found"})

if "Side by side:" in prompt and "step" in entry["tools"]:
    side_by_side()
elif "android" in plan:
    call("finish", {"status": "pass", "notes": plan})
else:
    call("session", {"action": "start", "id": "w", "target": "examples/demo/login.html"})
    # FAKE_CLAUDE_FAIL_FILE: fail only while that file exists (R1: a problem that starts after a release).
    fail_file = os.environ.get("FAKE_CLAUDE_FAIL_FILE")
    failing = os.environ.get("FAKE_CLAUDE_FAIL") == "1" or bool(fail_file and os.path.exists(fail_file))
    check = "{ text: Nope, timeout: 500 }" if failing else "Budi"
    r = call("run_flow", {"flow": "- inputText: { into: Email, text: a@b.com }\n"
                                  "- inputText: { into: Password, text: \"${DEMO_PASS}\" }\n"
                                  f"- tapOn: Masuk\n- assertVisible: {check}\n"})
    call("finish", {"status": "fail" if r.get("isError") else "pass", "notes": "checked Budi on the dashboard"})
proc.stdin.close()
proc.wait(timeout=10)
result("done", turns=len(entry["calls"]))
