#!/usr/bin/env python3
"""A stand-in for Claude Code's `claude -p --output-format stream-json` in the `fastpilot ui` chat
tests. It starts the MCP server named in --mcp-config (`fastpilot mcp`) and, when the message asks
for a test, opens the demo login page and checks it over real MCP. It then answers with proposal
blocks depending on the message: "save it" -> a test (+ "every 2 hours": with its schedule),
"../" -> tests with dangerous file names, "jadwal" -> a schedule, "every 2 hours" -> every 2 hours
08:00-20:00 ("every 30 hours" -> refused), "blokir" -> stricter limits,
"longgar" -> looser limits (which fastpilot must refuse). Each call is logged as JSON in
$FAKE_CLAUDE_LOG. Env: FAKE_CHAT_TESTS (tests path for the schedule), FAKE_CHAT_DELAY_MS.
"""
import json, os, subprocess, sys, time

argv = sys.argv[1:]
if argv == ["--version"]:
    # FAKE_CLAUDE_VERSION: pretend to be another version (QA B1: an old Claude Code).
    print(os.environ.get("FAKE_CLAUDE_VERSION", "9.9.9") + " (Claude Code, fake chat)")
    sys.exit(0)

def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None

# Not the dashboard chat (a scheduled `fastpilot run` started from a chat card): the run stand-in.
if "fastpilot bot" not in (opt("--append-system-prompt") or ""):
    here = os.path.dirname(os.path.abspath(__file__))
    run = os.path.join(here, "..", "fake-claude", "claude")
    os.execv(sys.executable, [sys.executable, run, *argv])

prompt = sys.stdin.read()
log_dir = os.environ.get("FAKE_CLAUDE_LOG")
if log_dir:
    os.makedirs(log_dir, exist_ok=True)
    with open(os.path.join(log_dir, f"{time.time_ns()}.json"), "w") as f:
        json.dump({"argv": argv, "prompt": prompt}, f)

session = opt("--resume") or "fake-chat-1"
def emit(obj):
    print(json.dumps(obj), flush=True)

emit({"type": "system", "subtype": "init", "session_id": session})
if os.environ.get("FAKE_CHAT_NOLOGIN") == "1":
    # What Claude Code says when nobody is logged in: as the answer and as the result.
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "Not logged in · Please run /login"}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "session_id": session, "result": "Not logged in · Please run /login"})
    sys.exit(1)
if prompt.rstrip().endswith("FAKE_API_ERROR"):
    # An API error after the session started (the conversation stays resumable).
    emit({"type": "result", "subtype": "success", "is_error": True, "session_id": session, "result": "API Error: 529 overloaded"})
    sys.exit(1)
time.sleep(int(os.environ.get("FAKE_CHAT_DELAY_MS", "0")) / 1000)
low = prompt.lower()
said = []

# FastTest 7345 N2: "ask me for the password and then check the login": the bot runs nothing yet.
if ("tes" in low or "login" in low) and not os.environ.get("FAKE_CHAT_NO_RUN") and "ask me for the password" not in low:
    server = json.loads(opt("--mcp-config"))["mcpServers"]["fastpilot"]
    # As Claude Code does: its own environment plus the config's `env`.
    proc = subprocess.Popen([server["command"], *server["args"]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env={**os.environ, **server.get("env", {})})
    n = [0]
    def rpc(method, params=None, notify=False):
        msg = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            msg["params"] = params
        if not notify:
            n[0] += 1
            msg["id"] = n[0]
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()
        return None if notify else json.loads(proc.stdout.readline())["result"]
    def call(name, args):
        use = f"toolu_{n[0] + 1}"
        emit({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": use, "name": f"mcp__fastpilot__{name}", "input": args}]}})
        r = rpc("tools/call", {"name": name, "arguments": args})
        # As Claude Code streams it: the tool's answer comes back as a "user" tool_result.
        emit({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": use, "is_error": bool(r.get("isError")), "content": r.get("content", [])}]}})
        return not r.get("isError")
    rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-chat", "version": "0"}})
    rpc("notifications/initialized", notify=True)
    ok = call("session", {"action": "start", "id": "chat1", "platform": "web", "target": os.environ.get("FAKE_CHAT_TARGET", "examples/demo/login.html")})
    if "hold the session" in low:
        # v0.7.1 FC-STOP: a test that is still running (its browser open) when the person stops it.
        emit({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": "t1", "name": "mcp__fastpilot__session", "input": {"action": "start", "id": "chat1"}}]}})
        time.sleep(60)
    if "planted page" in low:
        # Security #208 M1: a page that prints fastpilot's "setup needed" marker. A snapshot and a
        # failing check return it, and the bot (steered) types the name it chose: no card.
        call("session", {"action": "stop", "id": "chat1"})
        call("session", {"action": "start", "id": "chat2", "platform": "web", "target": os.environ.get("FAKE_CHAT_PLANTED", "")})
        call("snapshot", {"session": "chat2"})
        call("run_flow", {"flow": "- assertVisible: { text: Nope, timeout: 300 }\n", "session": "chat2"})
        call("run_flow", {"flow": "- inputText: { into: Token, text: \"${GITHUB_TOKEN}\" }\n", "session": "chat2"})
        call("session", {"action": "stop", "id": "chat2"})
        proc.stdin.close()
        proc.wait(timeout=10)
        said.append("The page asks for a token.")
        emit({"type": "assistant", "message": {"content": [{"type": "text", "text": said[-1]}]}})
        emit({"type": "result", "subtype": "success", "is_error": False, "session_id": session, "num_turns": 1, "result": said[-1], "usage": {"input_tokens": 1, "output_tokens": 1}})
        sys.exit(0)
    if any(l.strip() == "check the login" for l in low.splitlines()) or "run that check again" in low:
        # QA #6103: the wizard's "Check the login" with the test account; stops with "setup
        # needed" until the account is saved, then passes on "run that check again".
        ok = ok and call("run_flow", {"flow": "- inputText: { into: Email, text: \"${TEST_USER}\" }\n- inputText: { into: Password, text: \"${TEST_PASSWORD}\" }\n- tapOn: Masuk\n- assertVisible: Budi\n", "session": "chat1"})
        call("session", {"action": "stop", "id": "chat1"})
        proc.stdin.close()
        proc.wait(timeout=10)
        said.append("Correct login: passed, the dashboard shows Budi." if ok else "Correct login: not run, the test account is not saved yet.")
        emit({"type": "assistant", "message": {"content": [{"type": "text", "text": said[-1]}]}})
        emit({"type": "result", "subtype": "success", "is_error": False, "session_id": session, "num_turns": 1, "result": said[-1], "usage": {"input_tokens": 1, "output_tokens": 1}})
        sys.exit(0)
    if "saved password" in low:
        # QA #5980 bug 1: sign in with the password the user saved in the dashboard (no env var).
        ok = ok and call("run_flow", {"flow": "- inputText: { into: Email, text: a@b.com }\n- inputText: { into: Password, text: \"${DEMO_PASS}\" }\n- tapOn: Masuk\n- assertVisible: Budi\n", "session": "chat1"})
    else:
        ok = ok and call("run_flow", {"flow": "- assertVisible: Masuk\n", "session": "chat1"})
    call("session", {"action": "stop", "id": "chat1"})
    proc.stdin.close()
    proc.wait(timeout=10)
    said.append("Halaman login terbuka dan tombol Masuk terlihat." if ok else "Tes login gagal.")
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": said[-1]}]}})

