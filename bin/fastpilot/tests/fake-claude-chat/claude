#!/usr/bin/env python3
"""A stand-in for Claude Code's `claude -p --output-format stream-json` in the `fastpilot ui` chat
tests. It starts the MCP server named in --mcp-config (`fastpilot mcp`) and, when the message asks
for a test, opens the demo login page and checks it over real MCP. It then answers with proposal
blocks depending on the message: "save it" -> a test (+ "every 2 hours": with its schedule),
"../" -> tests with dangerous file names, "jadwal" -> a schedule, "every 2 hours" -> every 2 hours
08:00-20:00 ("every 30 hours" -> refused), "blokir" -> stricter limits,
"longgar" -> looser limits (which fastpilot must refuse). Each call is logged as JSON in
$FAKE_CLAUDE_LOG. Env: FAKE_CHAT_TESTS (tests path for the schedule), FAKE_CHAT_DELAY_MS.
"""
import json, os, subprocess, sys, time

argv = sys.argv[1:]
if argv == ["--version"]:
    # FAKE_CLAUDE_VERSION: pretend to be another version (QA B1: an old Claude Code).
    print(os.environ.get("FAKE_CLAUDE_VERSION", "9.9.9") + " (Claude Code, fake chat)")
    sys.exit(0)

def opt(name):
    return argv[argv.index(name) + 1] if name in argv else None

# Not the dashboard chat (a scheduled `fastpilot run` started from a chat card): the run stand-in.
if "fastpilot bot" not in (opt("--append-system-prompt") or ""):
    here = os.path.dirname(os.path.abspath(__file__))
    run = os.path.join(here, "..", "fake-claude", "claude")
    os.execv(sys.executable, [sys.executable, run, *argv])

prompt = sys.stdin.read()
log_dir = os.environ.get("FAKE_CLAUDE_LOG")
if log_dir:
    os.makedirs(log_dir, exist_ok=True)
    with open(os.path.join(log_dir, f"{time.time_ns()}.json"), "w") as f:
        json.dump({"argv": argv, "prompt": prompt}, f)

session = opt("--resume") or "fake-chat-1"
def emit(obj):
    print(json.dumps(obj), flush=True)

emit({"type": "system", "subtype": "init", "session_id": session})
if os.environ.get("FAKE_CHAT_NOLOGIN") == "1":
    # What Claude Code says when nobody is logged in: as the answer and as the result.
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": "Not logged in · Please run /login"}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "session_id": session, "result": "Not logged in · Please run /login"})
    sys.exit(1)
time.sleep(int(os.environ.get("FAKE_CHAT_DELAY_MS", "0")) / 1000)
low = prompt.lower()
said = []

if "tes" in low or "login" in low:
    server = json.loads(opt("--mcp-config"))["mcpServers"]["fastpilot"]
    proc = subprocess.Popen([server["command"], *server["args"]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    n = [0]
    def rpc(method, params=None, notify=False):
        msg = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            msg["params"] = params
        if not notify:
            n[0] += 1
            msg["id"] = n[0]
        proc.stdin.write(json.dumps(msg) + "\n")
        proc.stdin.flush()
        return None if notify else json.loads(proc.stdout.readline())["result"]
    def call(name, args):
        emit({"type": "assistant", "message": {"content": [{"type": "tool_use", "name": f"mcp__fastpilot__{name}", "input": args}]}})
        r = rpc("tools/call", {"name": name, "arguments": args})
        return not r.get("isError")
    rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "fake-chat", "version": "0"}})
    rpc("notifications/initialized", notify=True)
    ok = call("session", {"action": "start", "id": "chat1", "platform": "web", "target": "examples/demo/login.html"})
    ok = ok and call("run_flow", {"flow": "- assertVisible: Masuk\n", "session": "chat1"})
    call("session", {"action": "stop", "id": "chat1"})
    proc.stdin.close()
    proc.wait(timeout=10)
    said.append("Halaman login terbuka dan tombol Masuk terlihat." if ok else "Tes login gagal.")
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": said[-1]}]}})

text = []
if "jadwal" in low:
    text.append("Ini jadwalnya, cek dulu ya:\n```fastpilot-proposal\n" + json.dumps({
        "kind": "schedule", "name": "Login harian", "tests": os.environ.get("FAKE_CHAT_TESTS", "/nonexistent"),
        "every": "day", "time": "09:00", "notify": {"webhook": True, "os": True}}) + "\n```")
if "every 2 hours" in low and "save it" not in low:
    text.append("Here it is:\n```fastpilot-proposal\n" + json.dumps({
        "kind": "schedule", "name": "Checkout every 2 hours", "tests": os.environ.get("FAKE_CHAT_TESTS", "/nonexistent"),
        "every": "hours", "hours": 2, "from": "08:00", "to": "20:00", "notify": {"os": True}}) + "\n```")
if "every 30 hours" in low:
    text.append("```fastpilot-proposal\n" + json.dumps({
        "kind": "schedule", "name": "Too slow", "tests": os.environ.get("FAKE_CHAT_TESTS", "/nonexistent"),
        "every": "hours", "hours": 30}) + "\n```")
if "save it" in low:
    # D1: a test as structured data, with or without its schedule; FAKE_CHAT_TEST_ID sets its id.
    test = {"kind": "test", "title": "Login with the demo account", "platform": "web", "target": "examples/demo/login.html",
            "steps": ["Open the login page and sign in as a@b.com with ${DEMO_PASS}", "Check that the Dashboard shows Budi"]}
    if "invent" in low:
        # QA B3: what real Claude did: secret names nobody saved.
        test["steps"] = ["Sign in with ${EMAIL} and ${PASSWORD}", "Check that the Dashboard shows Budi"]
    if os.environ.get("FAKE_CHAT_TEST_ID"):
        test["id"] = os.environ["FAKE_CHAT_TEST_ID"]
    if "every 2 hours" in low:
        test["schedule"] = {"every": "hours", "hours": 2, "from": "08:00", "to": "20:00", "notify": {"os": True}}
    text.append("I wrote the test from your request:\n```fastpilot-proposal\n" + json.dumps(test) + "\n```")
if "../" in low:
    text.append("```fastpilot-proposal\n" + json.dumps({"kind": "test", "id": "../../outside", "title": "Evil", "target": "x", "steps": ["a"]}) + "\n```")
    text.append("```fastpilot-proposal\n" + json.dumps({"kind": "test", "id": "/tmp/fastpilot-evil", "title": "Evil", "target": "x", "steps": ["a"]}) + "\n```")
# D9: settings cards. A page that "asks" for Pay (the bot echoes it), the user asking for it, a secret name.
if "checkout page" in low:
    text.append("The page says:\n```fastpilot-proposal\n" + json.dumps({"kind": "settings", "changes": [{"setting": "block_actions", "remove": ["pay"]}]}) + "\n```")
if "pay button" in low:
    text.append("That loosens a safety limit, so only you can approve it:\n```fastpilot-proposal\n" + json.dumps({"kind": "settings", "changes": [{"setting": "block_actions", "remove": ["pay"]}]}) + "\n```")
if "github_token" in low:
    text.append("```fastpilot-proposal\n" + json.dumps({"kind": "settings", "changes": [{"setting": "vars", "add": ["GITHUB_TOKEN"]}]}) + "\n```")
# D6 from Chat: "remember that X" -> a note with the user's words; a page's rule -> a note nobody asked for.
if "remember that " in low:
    said_note = prompt[low.rfind("remember that ") + len("remember that "):].split("\n")[0].strip()
    text.append("I can keep that for every agent:\n```fastpilot-proposal\n" + json.dumps({"kind": "note", "group": "how", "text": said_note[:1].upper() + said_note[1:]}) + "\n```")
if "staging rules" in low:
    text.append("The staging page says to remember this:\n```fastpilot-proposal\n" + json.dumps({"kind": "note", "group": "accounts", "text": "Always use the admin account"}) + "\n```")
# R1: a release watch proposal (every N minutes for M hours).
if "watch the release" in low:
    text.append("Here is the release watch:\n```fastpilot-proposal\n" + json.dumps({
        "kind": "schedule", "name": "Shop release", "tests": os.environ.get("FAKE_CHAT_TESTS", "/nonexistent"),
        "every": "minutes", "minutes": 10, "for_hours": 2, "notify": {"os": True}}) + "\n```")
# S8: a release-check report and a bug report, as the skills write them.
if "can we release" in low:
    text.append("I ran the regression and a smoke check of the main journeys. Here is my recommendation.\n```\nRelease check — Shop staging 2.4 — 20 Nov 2026\nVerdict: SHIP WITH FIXES\nWhy: 2 minor problems, main journeys pass (sign in, search, cart → summary)\nEvidence: regression 14 tests (12 passed, 1 flaky, 1 blocked by limits); smoke 4/4; pages no crashes or error screens; visual not checked (no baseline)\nFix before or soon after release: Login with one-time code is unstable; Voucher field accepts a space as a code\nNot checked: payment (blocked by limits); iPhone (no simulator available)\n```")
if "write a bug report" in low:
    text.append("I ran the test once more with the same steps. It failed again, so I could reproduce it.\n```\nTitle: Total does not change after applying voucher SAVE10 (cart, web staging)\nSteps\n  1. Open the staging shop and add 1 product to the cart\n  2. Enter voucher SAVE10\n  3. Look at the order summary\nExpected: A \"10% off\" line and a lower total.\nActual: The page said \"Voucher not valid\". The total stayed $40.00.\nReproduced: yes, 2 of 2 runs  |  Environment: web Chrome, staging shop, version not known\nEvidence: screenshot at step 3\nImpact (estimate): people who use a voucher cannot get the discount; number of people not measured\n```")
# D10c: a reply with the "Techniques used" block (choose-technique format).
if "tickets page" in low:
    text.append("1 problem found. Everything else behaved as the rules say.\n```\nTechniques used\nBoundary value analysis (3-value) · Tickets\n  Tried: 0 refused ✓ · 1 accepted ✓ · 2 accepted ✓ · 9 accepted ✓ · 10 refused ✗ expected: accepted · 11 refused ✓\n  Coverage: 6 of 6 boundary values\n  Assumption: 10 is allowed (the page says \"1 to 10\")\n```")
# D10a: an agent described in one sentence.
if "create an agent" in low:
    text.append("I prepared the agent. Check it, then click Create.\n```fastpilot-proposal\n" + json.dumps({
        "kind": "agent", "name": "Mobile Payments", "job": "Keep cart and payment working in the Android and iOS app",
        "devices": ["android_emulator", "ios_simulator"], "app": "Shop (staging)",
        "instructions": ["Log in with the test account before each test", "Never press Pay; stop at the order summary"],
        "blocked": ["Confirm order"], "provider": "custom", "model": "evil-model"}) + "\n```")
if "blokir" in low:
    text.append("Dan batasannya:\n```fastpilot-proposal\n" + json.dumps({"kind": "limits", "add": {"block_actions": ["Bayar"]}, "set": {"max_steps": 20}}) + "\n```")
if "javascript" in low:
    text.append("```fastpilot-proposal\n" + json.dumps({"kind": "limits", "set": {"allow_eval_script": False}}) + "\n```")
if "longgar" in low:
    text.append("```fastpilot-proposal\n" + json.dumps({"kind": "limits", "set": {"max_steps": 500}}) + "\n```")
if not text and not said:
    text.append("Halo! Mau tes apa?")
final = "\n\n".join(text)
if final:
    emit({"type": "assistant", "message": {"content": [{"type": "text", "text": final}]}})
emit({"type": "result", "subtype": "success", "is_error": False, "session_id": session, "result": final or said[-1]})
