<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fastpilot.demo"
    android:versionCode="1"
    android:versionName="1">
    <uses-permission android:name="android.permission.CAMERA" />
    <application android:label="fastpilot demo" android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        <!-- All activities live in Demo.java as nested classes; aliases give them the short names
             used by the host (`am start -n com.fastpilot.demo/.LoginActivity`). -->
        <activity android:name=".Demo$LoginActivity" android:label="Login" android:exported="true"
            android:windowSoftInputMode="adjustPan" />
        <activity android:name=".Demo$DashboardActivity" android:label="Dashboard" android:exported="false" />
        <activity android:name=".Demo$PayActivity" android:label="Pembayaran" android:exported="false" />
        <activity-alias android:name=".LoginActivity" android:targetActivity=".Demo$LoginActivity"
            android:label="Login" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".DashboardActivity" android:targetActivity=".Demo$DashboardActivity"
            android:label="Dashboard" android:exported="false" />
        <activity-alias android:name=".PayActivity" android:targetActivity=".Demo$PayActivity"
            android:label="Pembayaran" android:exported="false" />
    </application>
</manifest>
